{
    "_comment_1": "JiaMiaoDB configuration template.",
    "_comment_2": "Copy this file to jiamiao.config.json and fill in your ai.api_key.",
    "_comment_3": "jiamiao.config.json is gitignored so your real key stays local.",

    "server": {
        "host": "127.0.0.1",
        "port": 9615,
        "max_connections": 128,
        "worker_threads": 4
    },

    "storage": {
        "data_dir": "./data",
        "wal_dir": "./data/wal",
        "buffer_size_mb": 64,
        "checkpoint_interval": 5000
    },

    "ai": {
        "provider": "minimax",
        "api_key": "",
        "api_base": "https://api.minimaxi.com/v1",
        "model": "MiniMax-M2.7"
    },

    "node": {
        "id": "node-1",
        "role": "standalone",
        "peers": []
    },

    "verbose": false
}
